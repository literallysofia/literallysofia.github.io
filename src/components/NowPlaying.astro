---
/**
 * NowPlaying Component
 * Spotify "now playing" card fed by the now-playing Worker
 * (workers/now-playing). Falls back to "Last played" and stays
 * hidden when PUBLIC_NOW_PLAYING_URL is unset or the fetch fails.
 * Polls every 30s, only while the tab is visible.
 */

const endpoint = import.meta.env.PUBLIC_NOW_PLAYING_URL || '';
---

<!-- Collapsed until a track loads, then it opens and fades in (see music.css) -->
<section class="now-playing" aria-labelledby="now-playing-label" data-endpoint={endpoint}>
  <div class="np-inner">
    <h2 id="now-playing-label" class="label">Now playing</h2>
    <a class="np-card" href="#" target="_blank" rel="noopener noreferrer">
      <img class="np-art" alt="" width="64" height="64" />
      <span class="np-info">
        <span class="np-status"><span class="np-dot" aria-hidden="true"></span><span data-np-status></span></span>
        <span class="np-title" data-np-title></span>
        <span class="np-artist" data-np-artist></span>
        <span class="np-bar" aria-hidden="true"><span data-np-progress></span></span>
      </span>
    </a>
  </div>
</section>

<script>
  import { getNowPlaying } from '../scripts/now-playing';

  const POLL_MS = 30_000;

  /** "2026-11-03T10:00:00Z" → "2h ago" */
  function timeAgo(iso?: string): string {
    if (!iso) return '';
    const minutes = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
    if (minutes < 60) return `${Math.max(1, minutes)}m ago`;
    const hours = Math.round(minutes / 60);
    return hours < 24 ? `${hours}h ago` : `${Math.round(hours / 24)}d ago`;
  }

  function initNowPlaying(): void {
    const section = document.querySelector<HTMLElement>('.now-playing');
    const endpoint = section?.dataset.endpoint;
    if (!section || !endpoint) return;

    const card = section.querySelector<HTMLAnchorElement>('.np-card')!;
    const art = section.querySelector<HTMLImageElement>('.np-art')!;
    const field = (name: string) => section.querySelector<HTMLElement>(`[data-np-${name}]`)!;

    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    /** Resolve once the cover is ready (or failed, or slow), so the card never opens on a blank square */
    const preload = (src: string) =>
      Promise.race([
        new Promise<void>((resolve) => {
          const img = new Image();
          img.onload = img.onerror = () => resolve();
          img.src = src;
        }),
        wait(1500),
      ]);

    // The bar moves every second between polls: where the song started and how long it is
    let song: { startedAt: number; durationMs: number; asked?: boolean } | null = null;

    function setProgress(): void {
      const pct = song ? Math.min(100, (100 * (Date.now() - song.startedAt)) / song.durationMs) : 0;
      field('progress').style.width = `${pct}%`;
      // Song over: ask what's next, once (the next poll catches it if it's too early)
      if (song && pct >= 100 && !song.asked) {
        song.asked = true;
        window.setTimeout(load, 2000);
      }
    }

    /** Once a track has shown, a failed or empty poll keeps it on screen instead of hiding the card */
    function stopPlaying(): void {
      song = null;
      section!.classList.remove('is-playing');
      setProgress();
      if (section!.classList.contains('is-ready')) field('status').textContent = 'Last played on Spotify';
    }

    async function load(): Promise<void> {
      if (document.hidden) return;
      try {
        const track = await getNowPlaying();
        // null: Spotify has nothing to show right now
        if (!track) return stopPlaying();

        const changed = field('title').textContent !== track.title || art.getAttribute('src') !== track.art;
        if (changed) {
          // A new song crossfades in (covers loaded first); the very first one opens the card
          const shown = section!.classList.contains('is-ready');
          if (shown && !reducedMotion()) section!.classList.add('is-changing');
          await Promise.all([track.art ? preload(track.art) : null, shown && !reducedMotion() ? wait(250) : null]);
          card.href = track.url;
          art.src = track.art;
          field('title').textContent = track.title;
          field('artist').textContent = `${track.artist} · ${track.album}`;
        }

        const ago = timeAgo(track.playedAt);
        field('status').textContent = track.isPlaying
          ? 'Listening now on Spotify'
          : ago
            ? `Last played · ${ago}`
            : 'Last played on Spotify';
        section!.classList.toggle('is-playing', track.isPlaying);
        song =
          track.isPlaying && track.durationMs
            ? { startedAt: track.receivedAt - (track.progressMs ?? 0), durationMs: track.durationMs }
            : null;
        setProgress();
        section!.classList.add('is-ready');
        requestAnimationFrame(() => section!.classList.remove('is-changing'));
      } catch {
        stopPlaying();
      }
    }

    load();
    const timer = window.setInterval(load, POLL_MS);
    const ticker = window.setInterval(() => song && !document.hidden && setProgress(), 1000);
    document.addEventListener('visibilitychange', load);
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.clearInterval(timer);
        window.clearInterval(ticker);
        document.removeEventListener('visibilitychange', load);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initNowPlaying);
</script>
