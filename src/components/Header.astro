---
/**
 * Header Component
 * Site-wide header with responsive navigation and dark mode toggle
 * Features:
 * - Desktop horizontal navigation
 * - Mobile hamburger menu with animated slide-in
 * - Dark/light mode toggle (desktop & mobile)
 * - Conditional rendering for 404 pages
 */

import { siteConfig } from "../config";
import "../styles/header.css";

interface Props {
  isNotFound?: boolean;
}

const { isNotFound = false } = Astro.props;
---

<header>
  {/* Brand/Logo */}
  <a href="/" class="navbar-brand" aria-label="Home"> sofia silva </a>

  {/* Main Navigation - Hidden on 404 pages */}
  {!isNotFound && (
    <>
      {/* Desktop Navigation */}
      <div class="desktop-nav">
        <nav aria-label="Primary navigation">
          {siteConfig.navLinks.map((link) => (
            <div class="nav-item">
              <a href={link.url}>{link.name}</a>
            </div>
          ))}
        </nav>
      </div>

      {/* Desktop Dark Mode Toggle */}
      <div class="desktop-toggle">
        <button
          id="dark-mode-toggle"
          aria-label="Toggle dark mode"
          class="dark-mode-toggle"
        >
          <span class="toggle-icon" aria-hidden="true" />
        </button>
      </div>

      {/* Mobile Menu Toggle Button */}
      <button id="burger" class="mobile-burger" aria-label="Toggle menu" aria-expanded="false">
        <div class="burger-lines">
          <span />
          <span />
        </div>
      </button>

      {/* Mobile Menu Overlay */}
      <div id="mobile-menu" class="menu" role="navigation" aria-label="Mobile navigation">
        <nav>
          {siteConfig.navLinks.map((link, index) => (
            <div class="nav-item" data-delay={index + 1}>
              <a href={link.url}>{link.name}</a>
            </div>
          ))}
        </nav>

        {/* Mobile Dark Mode Toggle */}
        <button
          id="dark-mode-toggle-mobile"
          aria-label="Toggle dark mode"
          class="dark-mode-toggle"
          data-delay={siteConfig.navLinks.length + 1}
        >
          <span class="toggle-icon" aria-hidden="true" />
        </button>
      </div>
    </>
  )}
</header>

<script>
  /**
   * ================================================
   * DARK MODE TOGGLE
   * ================================================
   * Manages theme switching between light and dark modes
   * Persists preference to localStorage
   * Syncs icon state across desktop and mobile toggles
   */
  function initDarkMode(): void {
    const toggleDesktop = document.getElementById("dark-mode-toggle");
    const toggleMobile = document.getElementById("dark-mode-toggle-mobile");

    /**
     * Update toggle button icons based on current theme
     * @param isDark - Whether dark mode is active
     */
    function updateToggleIcons(isDark: boolean): void {
      const icon = isDark ? "☀️" : "🌙";
      document.querySelectorAll(".toggle-icon").forEach((el) => {
        el.textContent = icon;
      });
    }

    /**
     * Toggle between light and dark mode
     * Updates DOM classes and localStorage preference
     */
    function toggleDarkMode(): void {
      const html = document.documentElement;
      const body = document.body;
      const isDark = html.classList.contains("dark-mode");

      if (isDark) {
        // Switch to light mode
        html.classList.remove("dark-mode");
        html.classList.add("light-mode");
        body.classList.remove("dark-mode");
        body.classList.add("light-mode");
        localStorage.setItem("theme", "light");
        updateToggleIcons(false);
      } else {
        // Switch to dark mode
        html.classList.remove("light-mode");
        html.classList.add("dark-mode");
        body.classList.remove("light-mode");
        body.classList.add("dark-mode");
        localStorage.setItem("theme", "dark");
        updateToggleIcons(true);
      }
    }

    // Initialize toggle icons based on current theme
    const isDark = document.documentElement.classList.contains("dark-mode");
    updateToggleIcons(isDark);

    // Attach event listeners to both desktop and mobile toggles
    toggleDesktop?.addEventListener("click", toggleDarkMode);
    toggleMobile?.addEventListener("click", toggleDarkMode);
  }

  /**
   * ================================================
   * MOBILE MENU TOGGLE
   * ================================================
   * Manages mobile navigation menu open/close state
   * Features staggered animation for menu items
   * Auto-closes on navigation link clicks
   */
  function initMobileMenu(): void {
    const burger = document.getElementById("burger");
    const menu = document.getElementById("mobile-menu");
    const menuItems = menu?.querySelectorAll(".nav-item, .dark-mode-toggle");
    const menuLinks = menu?.querySelectorAll("a");

    /**
     * Open mobile menu with staggered item animations
     */
    function openMenu(): void {
      burger?.classList.add("open");
      burger?.setAttribute("aria-expanded", "true");

      // Make menu visible
      if (menu) {
        menu.style.display = "flex";
      }

      // Force reflow to ensure display change registers
      menu?.offsetHeight;

      // Trigger fade-in animation
      requestAnimationFrame(() => {
        menu?.classList.add("open");

        // Apply staggered animations to menu items
        menuItems?.forEach((item) => {
          const delay = item.getAttribute("data-delay");
          item.classList.add("menu-item-animate");
          if (delay && item instanceof HTMLElement) {
            item.style.animationDelay = `${parseInt(delay) * 0.1 + 0.2}s`;
          }
        });
      });
    }

    /**
     * Close mobile menu and clean up animation classes
     */
    function closeMenu(): void {
      burger?.classList.remove("open");
      burger?.setAttribute("aria-expanded", "false");
      menu?.classList.remove("open");

      // Remove animation classes
      menuItems?.forEach((item) => {
        item.classList.remove("menu-item-animate");
        if (item instanceof HTMLElement) {
          item.style.animationDelay = "";
        }
      });

      // Hide menu after fade-out animation completes
      setTimeout(() => {
        if (menu && !menu.classList.contains("open")) {
          menu.style.display = "none";
        }
      }, 400);
    }

    /**
     * Toggle menu open/closed state
     */
    function toggleMenu(): void {
      if (burger?.classList.contains("open")) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    // Attach click handler to burger button
    burger?.addEventListener("click", toggleMenu);

    // Close menu when user clicks a navigation link
    menuLinks?.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }

  /**
   * ================================================
   * SCROLL BORDER EFFECT
   * ================================================
   * Shows a bottom border on the header when user scrolls down
   * Fades in/out smoothly based on scroll position
   */
  function initScrollBorder(): void {
    const header = document.querySelector("header");
    let ticking = false;

    /**
     * Handle scroll events with throttling for performance
     */
    function handleScroll(): void {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrolled = window.scrollY > 0;
          header?.classList.toggle("scrolled", scrolled);
          ticking = false;
        });
        ticking = true;
      }
    }

    // Attach scroll listener
    window.addEventListener("scroll", handleScroll, { passive: true });

    // Set initial state
    handleScroll();
  }

  /**
   * ================================================
   * INITIALIZATION
   * ================================================
   */

  // Initialize all features on page load
  initDarkMode();
  initMobileMenu();
  initScrollBorder();

  // Re-initialize after Astro view transitions (SPA navigation)
  document.addEventListener("astro:after-swap", () => {
    initDarkMode();
    initMobileMenu();
    initScrollBorder();
  });
</script>
