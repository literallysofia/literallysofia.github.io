---
import { Image } from 'astro:assets';

interface Education {
  date: string;
  degree: string;
  school: string;
  web: string;
  details?: string;
  link?: string;
}

interface Language {
  language: string;
  icon: string;
  level: string;
}

interface Props {
  title: string;
  education: Education[];
  languages: Language[];
}

const { title, education, languages } = Astro.props;

const galleryImages = [
  { src: '../assets/gallery-1.jpg', alt: 'childhood beach' },
  { src: '../assets/gallery-2.jpg', alt: 'new york' },
  { src: '../assets/gallery-3.png', alt: 'paris' },
  { src: '../assets/gallery-4.png', alt: 'cozy home' },
  { src: '../assets/gallery-5.png', alt: 'paramore' },
  { src: '../assets/gallery-6.png', alt: 'porto' },
  { src: '../assets/gallery-7.png', alt: 'london' },
  { src: '../assets/gallery-8.png', alt: 'twenty one pilots' },
  { src: '../assets/gallery-9.jpg', alt: 'nico, wfh buddy' },
];

const galleryImports = await Promise.all(
  galleryImages.map(img => import(img.src))
);

const gallery = galleryImages.map((img, index) => ({
  ...img,
  module: galleryImports[index].default,
}));

const imageProps = {
  width: 400,
  quality: 75,
  format: 'webp',
  loading: 'lazy' as const
};
---

<section id="about">
  <h2 class="heading">{title}</h2>
  <div class="about-content">
    <div class="about-details">
      <div class="description">
        <slot />
      </div>
      <div class="about-grid">
        <div class="education-list">
          <h3>Education</h3>
          {education.map((edu) => (
            <div class="education">
              <span>{edu.date}</span>
              <h4>{edu.degree}</h4>
              <a href={edu.web} target="_blank" rel="noopener noreferrer">
                {edu.school}
              </a>
              {edu.details && (
                <p>
                  {edu.details}
                  {edu.link && (
                    <>
                      <a
                        class="ref"
                        href={edu.link}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        (Link)
                      </a>
                    </>
                  )}
                </p>
              )}
            </div>
          ))}
        </div>
        <div class="languages-list">
          <h3>Languages</h3>
          {languages.map((lang) => (
            <div class="language">
              <div class="language-heading">
                <span>{lang.icon}</span>
                <h4>{lang.language}</h4>
              </div>
              <p>{lang.level}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="about-gallery">
      <div class="gallery-column">
        {[0, 2, 4, 6, 8].map((index) => (
          <div class="image">
            <Image
              src={gallery[index].module}
              alt={gallery[index].alt}
              {...imageProps}
            />
            <span class="image-caption">{gallery[index].alt}</span>
          </div>
        ))}
      </div>
      <div class="gallery-column">
        {[1, 3, 5, 7].map((index) => (
          <div class="image">
            <Image
              src={gallery[index].module}
              alt={gallery[index].alt}
              {...imageProps}
            />
            <span class="image-caption">{gallery[index].alt}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
