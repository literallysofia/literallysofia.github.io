---
/**
 * About Component
 * Displays personal information, education, languages, and photo gallery
 * Features:
 * - Education history with external school links
 * - Language proficiency list
 * - Two-column quirky photo gallery with hover effects
 * - Optimized images (WebP format, lazy loading)
 * - Responsive layout (side-by-side desktop, stacked mobile)
 */

import { Image } from 'astro:assets';

interface Education {
  date: string;
  degree: string;
  school: string;
  web: string;
  details?: string;
  link?: string;
}

interface Language {
  language: string;
  icon: string;
  level: string;
}

interface Props {
  title: string;
  education: Education[];
  languages: Language[];
}

const { title, education, languages } = Astro.props;

/**
 * Gallery image configuration
 * Images are split into two columns for quirky staggered layout
 */
import gallery1 from '../assets/gallery-1.jpg';
import gallery2 from '../assets/gallery-2.jpg';
import gallery3 from '../assets/gallery-3.png';
import gallery4 from '../assets/gallery-4.png';
import gallery5 from '../assets/gallery-5.png';
import gallery6 from '../assets/gallery-6.png';
import gallery7 from '../assets/gallery-7.png';
import gallery8 from '../assets/gallery-8.png';
import gallery9 from '../assets/gallery-9.jpg';

const gallery = [
  { module: gallery1, alt: 'childhood beach' },
  { module: gallery2, alt: 'new york' },
  { module: gallery3, alt: 'paris' },
  { module: gallery4, alt: 'cozy home' },
  { module: gallery5, alt: 'paramore' },
  { module: gallery6, alt: 'porto' },
  { module: gallery7, alt: 'london' },
  { module: gallery8, alt: 'twenty one pilots' },
  { module: gallery9, alt: 'nico, wfh buddy' },
];

// Shared image optimization properties
const imageProps = {
  width: 400,
  quality: 75,
  format: 'webp' as const,
  loading: 'lazy' as const
};
---

<section id="about" class="about" aria-labelledby="about-heading">
  <h2 id="about-heading" class="heading">{title}</h2>

  <div class="about-content">
    {/* Left Column - Personal Info, Education, Languages */}
    <div class="about-details">
      {/* Personal Description - Content from slot */}
      <div class="description">
        <slot />
      </div>

      {/* Education & Languages Grid */}
      <div class="about-grid">
        {/* Education Section */}
        <div class="education-list">
          <h3>Education</h3>
          {education.map((edu) => (
            <article class="education">
              <time datetime={edu.date}>{edu.date}</time>
              <h4>{edu.degree}</h4>
              <a
                href={edu.web}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${edu.school} website`}
              >
                {edu.school}
              </a>
              {edu.details && (
                <p>
                  {edu.details}
                  {edu.link && (
                    <a
                      class="ref"
                      href={edu.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="View related link"
                    >
                      (Link)
                    </a>
                  )}
                </p>
              )}
            </article>
          ))}
        </div>

        {/* Languages Section */}
        <div class="languages-list">
          <h3>Languages</h3>
          {languages.map((lang) => (
            <article class="language">
              <div class="language-heading">
                <span aria-hidden="true">{lang.icon}</span>
                <h4>{lang.language}</h4>
              </div>
              <p>{lang.level}</p>
            </article>
          ))}
        </div>
      </div>
    </div>

    {/* Right Column - Photo Gallery */}
    <div class="about-gallery" role="region" aria-label="Photo gallery">
      {/* Left Gallery Column (odd indices) */}
      <div class="gallery-column">
        {[0, 2, 4, 6, 8].map((index) => (
          <figure class="image">
            <Image
              src={gallery[index].module}
              alt={gallery[index].alt}
              {...imageProps}
            />
            <figcaption class="image-caption">
              {gallery[index].alt}
            </figcaption>
          </figure>
        ))}
      </div>

      {/* Right Gallery Column (even indices) */}
      <div class="gallery-column">
        {[1, 3, 5, 7].map((index) => (
          <figure class="image">
            <Image
              src={gallery[index].module}
              alt={gallery[index].alt}
              {...imageProps}
            />
            <figcaption class="image-caption">
              {gallery[index].alt}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
