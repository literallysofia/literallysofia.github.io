---
/**
 * Banner Component
 * Hero section for the home page with portrait and introduction
 * Features:
 * - Portrait image with fade-in animation
 * - Staggered text animations for title, subtitle, and description
 * - Dynamic job position with company link
 * - Fully customizable content via props
 */

import { Image } from 'astro:assets';

interface Props {
  /** Main greeting/title */
  title?: string;
  /** Role/profession subtitle */
  subtitle?: string;
  /** Personal tagline/slogan */
  slogan?: string;
  /** Current job position text */
  jobPosition?: string;
  /** Company website URL */
  jobPositionLink?: string;
}

const {
  title = "Hey, i'm sofia",
  subtitle = "software engineer + all things frontend + ui/ux designer",
  slogan = "a passionate product engineer 🍏 with a strong focus on design and leadership \n driven by the idea of blending engineering with aesthetics to build modern, meaningful interactions that improve people's lives",
  jobPosition = "📍 senior iOS engineer @ qonto",
  jobPositionLink = "https://qonto.com"
} = Astro.props;

// Import portrait image
const portraitImage = await import('../assets/portrait.jpg');

/**
 * Generate HTML for job position with embedded company link
 * @returns HTML string with company name linked
 */
const jobPositionHTML = jobPosition.replace(
  'qonto',
  `<a href="${jobPositionLink}" target="_blank" rel="noopener noreferrer">qonto</a>`
);
---

<section id="banner" class="banner" aria-labelledby="banner-title">
  <div class="banner-content">
    {/* Portrait Image */}
    <div class="image-wrapper animate-fade-in">
      <Image
        src={portraitImage.default}
        alt={`Portrait of ${title}`}
        loading="eager"
        quality={90}
      />
    </div>

    {/* Introduction Text */}
    <div class="banner-intro">
      {/* Subtitle/Role */}
      <span class="banner-subtitle animate-fade-in-up animate-delay-1">
        {subtitle}
      </span>

      {/* Main Title */}
      <h1 id="banner-title" class="animate-fade-in-up animate-delay-2">
        {title}
      </h1>

      {/* Tagline/Slogan */}
      <p class="animate-fade-in-up animate-delay-3">
        {slogan}
      </p>

      {/* Current Position */}
      <p class="animate-fade-in-up animate-delay-4" set:html={jobPositionHTML} />
    </div>
  </div>
</section>
