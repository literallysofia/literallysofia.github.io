---
import { Image } from 'astro:assets';

interface Props {
  title?: string;
  subtitle?: string;
  slogan?: string;
  jobPosition?: string;
  jobPositionLink?: string;
}

const {
  title = "Hey, i'm sofia",
  subtitle = "software engineer + all things frontend + ui/ux designer",
  slogan = "a passionate product engineer 🍏 with a strong focus on design and leadership \n driven by the idea of blending engineering with aesthetics to build modern, meaningful interactions that improve people's lives",
  jobPosition = "📍 senior iOS engineer @ qonto",
  jobPositionLink = "https://qonto.com"
} = Astro.props;

const portraitImage = await import('../assets/portrait.jpg');
---

<section id="banner">
  <div class="banner-content">
    <div class="image-wrapper animate-fade-in">
      <Image
        src={portraitImage.default}
        alt={title}
        loading="eager"
        quality={90}
      />
    </div>
    <div class="banner-intro">
      <span class="animate-fade-in-up animate-delay-1">{subtitle}</span>
      <h1 class="animate-fade-in-up animate-delay-2">{title}</h1>
      <p class="animate-fade-in-up animate-delay-3">{slogan}</p>
      <p class="animate-fade-in-up animate-delay-4" set:html={jobPosition.replace('qonto', `<a href="${jobPositionLink}" target="_blank" rel="noopener noreferrer">qonto</a>`)} />
    </div>
  </div>
</section>
