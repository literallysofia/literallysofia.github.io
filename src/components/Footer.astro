---
import { siteConfig } from '../config';
import GitHubIcon from './icons/GitHub.astro';
import LinkedInIcon from './icons/LinkedIn.astro';
import BehanceIcon from './icons/Behance.astro';

interface Props {
  animate?: boolean;
}

const { animate = false } = Astro.props;
const animationClass = animate ? 'animate-fade-in-up animate-delay-5' : '';
---

<footer>
  <ul class:list={['social-media', animationClass]}>
    {siteConfig.socialMedia.map((social) => (
      <li>
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.name}
        >
          {social.name === 'GitHub' && <GitHubIcon />}
          {social.name === 'Linkedin' && <LinkedInIcon />}
          {social.name === 'Behance' && <BehanceIcon />}
        </a>
      </li>
    ))}
  </ul>
  <p class:list={[animationClass]}>Crafted with 💜 © 2026 Sofia Silva</p>
</footer>
