---
/**
 * Work Experience Page
 * Timeline display of professional work history with scroll animations.
 * Content loaded from Astro content collections.
 */

import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Timeline from '../components/Timeline.astro';
import DownloadCV from '../components/DownloadCV.astro';
import Footer from '../components/Footer.astro';

const experienceCollection = await getCollection('experience');
const experience = experienceCollection[0];
---

<Layout>
  <Header />
  <main>
    <Timeline
      title={experience.data.title}
      jobs={experience.data.jobs}
    >
      <DownloadCV slot="action" />
    </Timeline>
  </main>
  <Footer />
</Layout>
