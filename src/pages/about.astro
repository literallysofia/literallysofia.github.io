---
/**
 * About Page
 * Personal information page with education, languages, and photo gallery.
 * Content loaded from Astro content collections.
 */

import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import AboutComponent from "../components/About.astro";
import Footer from "../components/Footer.astro";

const aboutCollection = await getCollection("about");
const aboutData = aboutCollection[0];
const { Content } = await render(aboutData);
---

<Layout protected={false}>
  <Header />
  <main>
    <AboutComponent
      title={aboutData.data.title}
      education={aboutData.data.education}
      languages={aboutData.data.languages}
    >
      <Content />
    </AboutComponent>
  </main>
  <Footer />
</Layout>
