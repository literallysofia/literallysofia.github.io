---
/**
 * Home Page
 * Full-screen hero, then selected work (App Store-style cards),
 * off-screen photos, and experience rows.
 */

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Banner from '../components/Banner.astro';
import TodayCard from '../components/TodayCard.astro';
import ExperienceRows from '../components/ExperienceRows.astro';
import Footer from '../components/Footer.astro';
import { offScreen } from '../data/gallery';

const [hero] = await getCollection('hero');
const [portfolio] = await getCollection('portfolio');
const featured = portfolio.data.projects.filter((project) => project.featured);
---

<Layout>
  <Header />
  <main class="home">
    <Banner {...hero.data} />

    <section class="home-work" aria-labelledby="selected-work">
      <h2 id="selected-work" class="label">Selected work</h2>
      <div class="card-grid">
        {featured.map((project) => (
          <div data-reveal>
            <TodayCard
              name={project.name}
              years={project.years}
              card={project.card}
              eyebrow="WHAT I BUILT"
              title={project.cardTitle}
              accent={project.cardAccent}
              subtitle={project.cardSubtitle}
              media={project.cardMedia}
              icon={project.icon}
              withBar
              href={`/work#${project.slug}`}
            />
          </div>
        ))}
      </div>
      <a href="/work" class="link section-more">All work →</a>
    </section>

    <section aria-labelledby="off-screen">
      <h2 id="off-screen" class="label">Off screen</h2>
      <div class="photo-strip">
        {offScreen.map((photo) => (
          <figure data-reveal>
            <Image src={photo.module} alt={photo.alt} width={600} widths={[300, 600]} sizes="(max-width: 768px) 50vw, 25vw" />
            <figcaption>{photo.alt}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section aria-labelledby="experience">
      <h2 id="experience" class="label">Experience</h2>
      <ExperienceRows field="summary" />
    </section>
  </main>
  <Footer />
</Layout>
